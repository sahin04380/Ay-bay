rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLedgerEntry(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.type is string &&
             data.type in ['in', 'out'] &&
             (data.amount is int || data.amount is float) &&
             data.amount > 0 &&
             data.amount <= 1000000000000 &&
             data.dateStr is string &&
             data.dateStr.size() == 10 &&
             data.dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.description is string &&
             data.description.size() <= 300 &&
             data.clientOrder is int &&
             data.clientOrder >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/entries/{entryId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(entryId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(entryId) &&
                       incoming().keys().hasAll([
                         'userId', 'type', 'amount', 'dateStr',
                         'description', 'clientOrder', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'type', 'amount', 'dateStr',
                         'description', 'clientOrder', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidLedgerEntry(incoming(), userId);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(entryId) &&
                       isValidLedgerEntry(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().clientOrder == existing().clientOrder &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'type', 'amount', 'dateStr', 'description', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(entryId);
    }
  }
}
